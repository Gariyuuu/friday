# Copy to .env.local inside apps/dashboard (or a root .env consumed via your process
# manager). Never commit the real file. Server-only keys must NOT be prefixed
# NEXT_PUBLIC_ — that prefix ships the value to the browser bundle.

# --- Development ---
# Simulates news/markets/weather/world-events/VM progress with clearly-labeled
# DEMO DATA so the UI can be built before any provider is configured.
FRIDAY_MOCK_MODE=true

# --- AI providers (Phase 5 — reasoning/orchestration, not built yet) ---
# OPENAI_API_KEY is also what Phase 4 voice uses (see below) — set it once, it
# covers both. ANTHROPIC_API_KEY/GEMINI_API_KEY are read by /api/config for status
# display only; nothing calls them yet.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Voice (Phase 4) ---
# Provider decision: OpenAI Realtime API (WebRTC) — chosen over LiveKit because it
# needs no separate server/infra to run and is cheaper for personal, low-volume use.
# Uses OPENAI_API_KEY above; the key needs Realtime API access. Once set, press
# ⌥ + Space anywhere in the app to start a voice session.

# --- News (Phase 3) ---
# newsapi.org free "developer" key. Note: NewsAPI's free plan is restricted by their
# terms to local/dev use, not a hosted production service — a fine fit for FRIDAY
# running on your own machine, not something to deploy publicly on the free tier.
# Without this set, the news panel shows clearly-labeled demo data instead.
NEWS_API_KEY=

# --- Markets (Phase 3) ---
# Crypto (BTC/ETH) is always live via CoinGecko's public API — no key needed.
# Equities/FX (S&P 500, NASDAQ, USD/JPY) need a free Twelve Data key:
# https://twelvedata.com/pricing — without it, the market panel still shows real
# crypto prices, just without the equity/FX rows.
TWELVE_DATA_API_KEY=

# --- Weather (Phase 3) ---
# Severe weather alerts are always live via api.weather.gov (NWS) — no key needed.
# US coverage only; global alert coverage is a future enhancement.

# --- Video / YouTube (Phase 3) ---
# YouTube Data API v3 key from Google Cloud Console (free quota). Powers real
# related-video results in the event detail panel and the search_video voice tool.
# Without this, those honestly say "not configured" instead of showing anything.
YOUTUBE_API_KEY=

# --- Web search (Phase 3) ---
# Tavily key (tavily.com) — built for LLM/agent search, generous free tier. Powers
# /api/search and the search_web voice tool. Without this, both honestly report
# unavailable rather than fabricating results.
SEARCH_API_KEY=

# --- Memory (Phase 7) ---
# No database needed — memory is a local SQLite file at ~/.friday/memory.db via
# Node's built-in node:sqlite. Nothing to configure here.

# --- Database (Phase 7, reserved for a future hosted-DB need) ---
DATABASE_URL=

# --- Cloud VM (Phase 8) ---
VM_GATEWAY_URL=
VM_GATEWAY_TOKEN=
