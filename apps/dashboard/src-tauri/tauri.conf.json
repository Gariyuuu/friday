{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FRIDAY",
  "version": "0.31.0",
  "identifier": "com.gariyuu.friday",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec next dev -p 1420",
    "beforeBuildCommand": "scripts/prepare-desktop-build.sh"
  },
  "app": {
    "windows": [
      {
        "title": "F.R.I.D.A.Y.",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../.next/standalone/apps/dashboard": "server"
    }
  }
}
